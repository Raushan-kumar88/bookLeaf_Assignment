# ------------------------------------------------------------------
# BookLeaf server configuration.
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ------------------------------------------------------------------

# HTTP port the API listens on
PORT=5000

# Node environment: development | production
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/bookleaf

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# LLM config — the key stays on the server ONLY, never sent to the frontend.
# If OPENAI_API_KEY is empty, the AI service falls back to a rules-based mode so
# the app still works (tickets are still created and classified heuristically).
#
# This project uses the OpenAI SDK, which also works with any OpenAI-COMPATIBLE
# provider via OPENAI_BASE_URL. Two common setups:
#
#   A) OpenAI:
#      OPENAI_API_KEY=sk-...
#      OPENAI_MODEL=gpt-4o-mini
#      OPENAI_BASE_URL=            (leave empty)
#
#   B) Google Gemini (OpenAI-compatible endpoint, has a free tier):
#      OPENAI_API_KEY=<your Gemini API key>
#      OPENAI_MODEL=gemini-flash-latest
#      OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Optional: comma-separated DNS servers. Set this only if your network cannot
# resolve MongoDB Atlas SRV records (error: "querySrv ECONNREFUSED").
# e.g. DNS_SERVERS=8.8.8.8,1.1.1.1
DNS_SERVERS=

# Frontend origin allowed by CORS (the Vite dev server)
CLIENT_URL=http://localhost:5173

# Password set on every seeded author/admin account (for local testing only)
SEED_DEFAULT_PASSWORD=Password123!
